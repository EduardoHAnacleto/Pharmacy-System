########################################
# DATABASE
########################################

# Root password — used only by the MySQL container and its healthcheck.
MYSQL_ROOT_PASSWORD=

# Database name, application user and password.
# The backend connection string is assembled from these in docker-compose.yml.
MYSQL_DATABASE=pharmacy_db
MYSQL_USER=
MYSQL_PASSWORD=

########################################
# CACHE
########################################

# Redis password. Must match the --requirepass argument in docker-compose.yml.
REDIS_PASSWORD=

########################################
# BACKEND
########################################

# Comma-separated list of origins allowed to call the API.
# Use the public URL of the frontend in production, e.g. https://shop.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

########################################
# FRONTEND (build-time, baked into the bundle)
########################################

# WhatsApp number in international format, digits only, no + or spaces.
VITE_WHATSAPP_NUMBER=
