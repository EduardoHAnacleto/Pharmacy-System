########################################
# DATABASE
########################################

# Root password — used only by the MySQL container and its healthcheck.
MYSQL_ROOT_PASSWORD=

# Database name, application user and password.
# The backend connection string is assembled from these in docker-compose.yml.
MYSQL_DATABASE=pharmacy_db
MYSQL_USER=
MYSQL_PASSWORD=

########################################
# CACHE
########################################

# Redis password. Must match the --requirepass argument in docker-compose.yml.
REDIS_PASSWORD=

########################################
# BACKEND
########################################

# Comma-separated list of origins allowed to call the API.
# Use the public URL of the frontend in production, e.g. https://shop.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# HMAC key used to sign access tokens. Minimum 32 characters; the API refuses to
# start with anything shorter. Generate one with:
#   openssl rand -base64 48
# Changing it invalidates every issued token, logging all admins out.
JWT_SIGNING_KEY=

########################################
# FIRST ADMIN ACCOUNT
########################################

# Used once, on startup, and only while the users table is empty. After the
# account exists these values are ignored, so changing the password here does
# not change the account's password.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_EMAIL=

########################################
# INITIAL STORE SETTINGS (optional)
########################################

# Written to store_settings ONCE, on the first startup with the table empty, so a
# new deployment arrives presentable. After that the admin screen at
# /admin/settings owns these values and changing them here has no effect.
#
# Everything else about the shop — colours, address, opening hours, delivery
# rules, which checkout fields to collect — is edited there, never here.

STORE_NAME=
STORE_CURRENCY=BRL
STORE_LOCALE=pt-BR
STORE_COUNTRY_CODE=BR
STORE_TIME_ZONE=America/Sao_Paulo

# International format, digits only, no + or spaces.
STORE_WHATSAPP_NUMBER=

# Path or URL to the shop logo. /logoFarma.png is the artwork bundled in
# frontend/public/ — set it to restore the existing pharmacy's banner.
STORE_LOGO_URL=

########################################
# OBSERVABILITY (optional)
########################################

# OTLP collector, e.g. http://otel-collector:4317. Left empty, instrumentation
# still runs and simply exports nothing.
OTLP_ENDPOINT=
OTEL_SERVICE_NAME=storefront-api

########################################
# DEPRECATED
########################################

# No longer read by any code: the WhatsApp number comes from store_settings at
# runtime, so it no longer has to be baked into the bundle at build time.
# Kept only so existing deployments that set it do not break. Safe to remove.
VITE_WHATSAPP_NUMBER=
