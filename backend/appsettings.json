{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": ""
  },

  "Uploads": {
    "MaxFileSizeBytes": 5242880
  },

  // Connection strings are supplied by the environment, never committed.
  // docker-compose.yml sets ConnectionStrings__DefaultConnection and
  // ConnectionStrings__Redis from the values in .env.
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  }
}
