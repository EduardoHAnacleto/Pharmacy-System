{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },

  // Vite dev server plus the nginx container.
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost"
  },

  // Set these locally without committing them, either with
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
  //   dotnet user-secrets set "Jwt:SigningKey" "<32+ random characters>"
  //   dotnet user-secrets set "AdminSeed:Username" "admin"
  //   dotnet user-secrets set "AdminSeed:Password" "<your own password>"
  // or via the matching ConnectionStrings__ / Jwt__ / AdminSeed__ environment
  // variables. Running through docker-compose.dev.yml supplies them from .env.
  //
  // No signing key or seed password is committed here on purpose: a value in
  // this file would be a known credential for every checkout of the repository.
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  }
}
