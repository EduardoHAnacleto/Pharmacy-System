{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  // Vite dev server plus the nginx container.
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost"
